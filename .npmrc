# Evita hoisting que quebra peerDependencies do Angular
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# Linka pacotes do workspace por faixa de versão (ex.: o peer
# @nativeguard/passkey ^1.0.0 da lib Angular resolve para o pacote local
# em vez de ser buscado no registry).
link-workspace-packages=true
